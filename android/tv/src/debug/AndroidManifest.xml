<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. DUMP is held by adb shell and by no ordinary app, so nothing on the device can ask for the
  pairing data; release builds do not have this receiver at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
