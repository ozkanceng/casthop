    "Board not listed? Is CastHop open on the board and the tablet on the same network? School networks may block discovery; the QR code always works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen not listed? Is CastHop open there and the tablet on the same network? School networks may block discovery; the QR code always works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran listede yoksa: orada CastHop açık ve tablet aynı ağda mı? Okul ağları aramayı engelleyebilir; QR kodu her zaman çalışır."
          }
        }
      }
    },
