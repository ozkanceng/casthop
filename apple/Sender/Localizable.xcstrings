    "If Wi-Fi drops briefly, mirroring recovers by itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Wi-Fi drops briefly, mirroring recovers by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi kısa süre koparsa yansıtma kendiliğinden sürer."
          }
        }
      }
    },
    "If the board can decode it in hardware, the same quality needs less data. Otherwise H.264 is used.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the screen can decode it in hardware, the same quality needs less data. Otherwise H.264 is used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran donanımla çözebiliyorsa aynı kalitede daha az veri gönderilir. Ekran desteklemiyorsa H.264 kullanılır."
          }
        }
      }
    },
    "If the school network blocks it: use the tablet's hotspot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the school network blocks it: use the tablet's hotspot"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okul ağı engelliyorsa: tabletin hotspot'u"
          }
        }
      }
    },
    "In Settings, set picture quality to \"Balanced\" or \"Weak network\". Prefer 5 GHz Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, set picture quality to \"Balanced\" or \"Weak network\". Prefer 5 GHz Wi-Fi."
