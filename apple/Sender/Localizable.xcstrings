{
  "sourceLanguage": "en",
  "strings": {
    "\"Pause\" keeps the last picture on the board while you do something else on the tablet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Pause\" keeps the last picture on the other screen while you do something else on the tablet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Duraklat\": karşı ekranda son görüntü kalır, tabletinizde başka bir şey yapabilirsiniz."
          }
        }
      }
    },
    "1080p, 60 fps. 5 GHz Wi-Fi recommended.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p, 60 fps. 5 GHz Wi-Fi recommended."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p, 60 fps. 5 GHz Wi-Fi önerilir."
          }
        }
      }
    },
    "720p, 30 fps for crowded or 2.4 GHz networks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, 30 fps for crowded or 2.4 GHz networks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalabalık veya 2,4 GHz ağlar için 720p, 30 fps."
          }
        }
      }
    },
    "A board you have connected to appears under \"Remembered boards\" on the home screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen you have connected to appears under \"Remembered screens\" on the home screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlandığınız ekran ana sayfada \"Hatırlanan ekranlar\" altında listelenir."
          }
        }
      }
    },
    "A few permissions are needed first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
