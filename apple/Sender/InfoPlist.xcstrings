{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read the QR code on the screen and to mirror the camera. Nothing is recorded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrandaki QR kodunu okumak ve kamerayı yansıtmak için. Görüntü kaydedilmez."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To connect to the screen on the same network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ağdaki ekrana bağlanmak için."
          }
        }
      }
    }
  },
  "version": "1.0"
}
