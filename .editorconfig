root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,qml}]
indent_size = 2

# Inno Setup reads a script as UTF-8 only with a byte order mark.
[*.iss]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
