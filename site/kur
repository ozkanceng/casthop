#!/bin/sh
# Yansıt Alıcı'yı tahtaya yönetici şifresi olmadan kurar ve başlatır; yeniden çalıştırmak son sürüme günceller.
#   wget -nv --tries=10 --retry-connrefused --waitretry=5 -O- https://ozkanceng.github.io/casthop/kur | sh
# Betiğin tamamı indirilmeden hiçbir şey çalışmasın diye her şey main içindedir.
set -eu

BASE="${YANSIT_RELEASE_URL:-https://github.com/ozkanceng/casthop/releases/latest/download}"
ARCHIVE="yansit-receiver-x86_64.tar.gz"
DEST="$HOME/.local/opt/yansit"

fail() {
    printf '\nKurulum tamamlanamadı: %s\n' "$1" >&2
    exit 1
}

fetch() {
    if command -v wget >/dev/null 2>&1; then
        wget -q --show-progress --tries=10 --retry-connrefused --waitretry=5 -O "$2" "$1"
    elif command -v curl >/dev/null 2>&1; then
        curl -fL --retry 10 --retry-connrefused --retry-delay 5 --progress-bar -o "$2" "$1"
    else
        fail "wget veya curl bulunamadı."
    fi
}

main() {
    [ "$(uname -m)" = "x86_64" ] || fail "Yansıt Alıcı yalnız 64 bit (x86_64) tahtalarda çalışır."

    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT

    echo "Yansıt Alıcı indiriliyor (yaklaşık 115 MB)..."
    fetch "$BASE/$ARCHIVE" "$work/$ARCHIVE" || fail "İndirilemedi. Tahtanın internet bağlantısını kontrol edin."
    fetch "$BASE/SHA256SUMS" "$work/SHA256SUMS" || fail "Sağlama dosyası indirilemedi."

    echo "Dosya doğrulanıyor..."
    (cd "$work" && grep "  $ARCHIVE\$" SHA256SUMS | sha256sum -c --quiet -) \
        || fail "İndirilen dosya bozuk. Komutu yeniden çalıştırın."

    # Güncellemede eski sürüm açıksa dosyaları değişmeden önce kapanmalı.
    pkill -f "$DEST/bin/yansit-receiver" 2>/dev/null || true

    mkdir "$work/package"
    tar -xzf "$work/$ARCHIVE" -C "$work/package" --strip-components=1
    sh "$work/package/install-user.sh" >/dev/null

    echo
    echo "Kurulum tamamlandı. Menüde 'Yansıt Alıcı' görünür."
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        nohup "$DEST/yansit-receiver" >/dev/null 2>&1 &
        echo "Yansıt Alıcı açılıyor; tabletle ekrandaki QR kodu okutun."
    fi
}

main
